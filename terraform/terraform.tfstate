            "user_data": "#!/bin/bash\n# CSYE 6225 - Assignment 5\n# Provided complete - do not modify.\n#\n# This script is templated by Terraform (see compute.tf) and used for\n# BOTH the public and private instances, with different values for\n# host_role. It requires no internet access: server.py uses only the\n# Python standard library, and python3 ships pre-installed on the\n# Ubuntu 22.04 AMI used by this assignment.\n#\n# Gradescope verifies bastion -\u003e private connectivity over plain HTTP\n# via server.py's /check-private endpoint - no SSH access is needed for\n# grading. You can still SSH in yourself using your own EC2 key pair\n# (key_name) for manual testing and debugging.\n\nset -e\n\nmkdir -p /opt/healthcheck\ncat \u003e /opt/healthcheck/server.py \u003c\u003c 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"\nCSYE 6225 - Assignment 5: VPC Networking with Terraform\n\nHealthcheck service used on BOTH the public (bastion) and private hosts.\n\nThis uses only the Python standard library - no pip install required.\nThis is deliberate: the private host has no internet access in this\nassignment (no NAT Gateway), so it cannot reach PyPI to install anything.\nSince Ubuntu 22.04 ships with python3 pre-installed, this script runs\nwith zero setup beyond copying the file itself.\n\nThe bastion (HOST_ROLE=public) also exposes /check-private, which proxies\na request to a target host's /healthcheck. This is how Gradescope verifies\nbastion -\u003e private connectivity over plain HTTP, without needing SSH\naccess - see the assignment instructions for details.\n\nDo NOT modify this file.\n\"\"\"\n\nimport json\nimport os\nimport urllib.error\nimport urllib.request\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nHOST_ROLE = os.environ.get(\"HOST_ROLE\", \"unknown\")\nPORT = int(os.environ.get(\"PORT\", 80))\nPROXY_TIMEOUT_SECONDS = 5\n\n\nclass HealthcheckHandler(BaseHTTPRequestHandler):\n    def _send_json(self, status_code, payload):\n        body = json.dumps(payload).encode(\"utf-8\")\n        self.send_response(status_code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n\n        if parsed.path == \"/healthcheck\":\n            self._send_json(200, {\"status\": \"ok\", \"host\": HOST_ROLE})\n            return\n\n        if parsed.path == \"/check-private\":\n            if HOST_ROLE != \"public\":\n                # Only the bastion proxies to another host.\n                self.send_response(404)\n                self.end_headers()\n                return\n\n            target = parse_qs(parsed.query).get(\"target\", [None])[0]\n            if not target:\n                self._send_json(400, {\"error\": \"missing required query parameter: target\"})\n                return\n\n            try:\n                url = f\"http://{target}/healthcheck\"\n                with urllib.request.urlopen(url, timeout=PROXY_TIMEOUT_SECONDS) as resp:\n                    body = resp.read()\n                self.send_response(200)\n                self.send_header(\"Content-Type\", \"application/json\")\n                self.send_header(\"Content-Length\", str(len(body)))\n                self.end_headers()\n                self.wfile.write(body)\n            except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:\n                self._send_json(502, {\"error\": f\"could not reach {target}: {exc}\"})\n            return\n\n        self.send_response(404)\n        self.end_headers()\n\n    def log_message(self, format, *args):\n        # Quiet down default stderr logging; systemd captures this either way.\n        pass\n\n\nif __name__ == \"__main__\":\n    server = ThreadingHTTPServer((\"0.0.0.0\", PORT), HealthcheckHandler)\n    server.serve_forever()\n\nPYEOF\n\ncat \u003e /etc/systemd/system/healthcheck.service \u003c\u003c EOF\n[Unit]\nDescription=CSYE 6225 Healthcheck Service\nAfter=network.target\n\n[Service]\nEnvironment=HOST_ROLE=public\nEnvironment=PORT=80\nExecStart=/usr/bin/python3 /opt/healthcheck/server.py\nRestart=on-failure\nUser=root\nWorkingDirectory=/opt/healthcheck\n\n[Install]\nWantedBy=multi-user.target\nEOF\n\nsystemctl daemon-reload\nsystemctl enable healthcheck.service\nsystemctl start healthcheck.service\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
            "vpc_security_group_ids": [
              "sg-01c159901ef7a1dc4"
            ]
          },
          "sensitive_attributes": [],
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDAsImRlbGV0ZSI6MTIwMDAwMDAwMDAwMCwicmVhZCI6OTAwMDAwMDAwMDAwLCJ1cGRhdGUiOjYwMDAwMDAwMDAwMH0sInNjaGVtYV92ZXJzaW9uIjoiMiJ9",
